<% layout('layouts/boilerplate') %>
<section id="add-movie-page">
    <h1 class="page-title">Add New Movie</h1>
    <div class="form-container">
        <form action="/movies" method="POST" novalidate class="validated-form">
            <div class="form-group">
                <label for="title">Title</label>
                <input type="text" id="title" name="movie[title]" required>
            </div>
            <div class="form-group">
                <label for="year">Year</label>
                <input type="number" id="year" name="movie[year]" required>
            </div>
            <div class="form-group">
                <label for="type">Format</label>
                <input type="text" id="type" name="movie[type]" placeholder="e.g., Movie or TV Series" required>
            </div>
            <div class="form-group">
                <label for="library">Category</label>
                <input type="text" id="library" name="movie[library]" placeholder="e.g., Hollywood, Bollywood, Korean" required>
            </div>
            <div class="form-group">
                <label for="genre">Genre</label>
                <input type="text" id="genre" name="movie[genre]" placeholder="e.g., Action, Thriller" required>
            </div>
            <div class="form-group">
                <label for="director">Director</label>
                <input type="text" id="director" name="movie[director]" placeholder="e.g., Christopher Nolan" required>
            </div>
            <div class="form-group">
                <label for="cast">Cast</label>
                <input type="text" id="cast" name="movie[cast]" placeholder="e.g., Leonardo DiCaprio, Joseph Gordon-Levitt, Elliot Page" required>
            </div>
            <div class="form-group">
                <label for="poster-url">Poster URL</label>
                <input type="url" id="poster-url" name="movie[poster]" placeholder="https://example.com/poster.jpg">
            </div>
            <div class="form-group">
                <label for="imdb-rating">IMDB Rating</label>
                <input type="number" id="imdb-rating" name="movie[imdbRating]" placeholder="e.g. 8.7" min="0" max="10" step="0.1" required>
            </div>
            <div class="form-group">
                 <label for="description">Description</label>
                 <textarea id="description" name="movie[description]" rows="3" required></textarea>
            </div>
            <button class="btn btn-blue" style="width: 100%;">Add Movie</button>
        </form>
    </div>
</section>
